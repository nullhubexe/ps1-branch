-- =========================================================
-- WEBHOOK
-- =========================================================
local function sendWebhook(content, embed)
    local data = { content = content or "", username = "t3ars" }
    if embed then data.embeds = { embed } end

    local HttpService = game:GetService("HttpService")
    local ok, json = pcall(function() return HttpService:JSONEncode(data) end)
    if not ok then warn("JSON encode failed: " .. tostring(json)) return end

    task.spawn(function()
        local success, response = pcall(function()
            local request = (syn and syn.request)
                         or (http and http.request)
                         or http_request
                         or request
            if not request then error("No HTTP request function available") end
            return request({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = json
            })
        end)
        if not success then
            warn("Failed to send webhook: " .. tostring(response))
        end
    end)
end

-- =========================================================
-- PET DETAILS
-- =========================================================
local function getPetDetails(petId)
    local stats = workspace.__REMOTES.Core["Get Stats"]:InvokeServer()
    local dir = require(game.ReplicatedStorage['1 | Directory']).Pets

    for _, pet in pairs(stats.Save.Pets) do
        if pet.id == petId then
            local petData = dir[pet.n]
            local name = petData and petData.DisplayName or "Unknown Pet"

            local variant = "Normal"
            if pet.dm and pet.r then variant = "Glitched"
            elseif pet.dm then variant = "DM"
            elseif pet.r then variant = "Rainbow"
            elseif pet.g then variant = "Gold" end

            return {
                name = name,
                variant = variant,
                level = pet.l or 0,
                n = pet.n,
                pet = pet
            }
        end
    end
    return { name = "Unknown Pet", variant = "Unknown", level = 0, n = nil, pet = nil }
end

