-- =========================================================
-- FARM LOOP  (big-cane fallback + zone routing)
-- =========================================================
local lastFire = {}

local function hasBigCane()
    for _, coin in ipairs(COINS:GetChildren()) do
        local n = coin:FindFirstChild("CoinName")
        if n and BIG_CANES[n.Value] then return true end
    end
    return false
end

local function classify(coinName)
    if BIG_CANES[coinName] then return "BIG_CANE" end
    if SMALL_CANES[coinName] then return "SMALL_CANE" end
    if ZONE2_BIG[coinName] then return "ZONE2_BIG" end
    if ZONE2_SMALL[coinName] then return "ZONE2_SMALL" end
    return nil
end

task.spawn(function()
    while _G.FARMING do
        local now = os.clock()
        local bigAvailable = hasBigCane()

        for _, coin in ipairs(COINS:GetChildren()) do
            local nameObj = coin:FindFirstChild("CoinName")
            if not nameObj then continue end
            local coinName = nameObj.Value
            local cat = classify(coinName)
            if not cat then continue end

            for _, a in ipairs(ASSIGNMENTS) do
                lastFire[a.id] = lastFire[a.id] or 0
                if now - lastFire[a.id] <= DELAY then continue end

                local shouldMine = false
                local t = a.targets

                if cat == "BIG_CANE" and t.BIG_CANE then
                    shouldMine = true
                elseif cat == "SMALL_CANE" and t.SMALL_CANE then
                    -- If no big cane up → everyone with SMALL_CANE mines smalls.
                    -- If big cane up → only pets WITHOUT BIG_CANE mine smalls.
                    if not bigAvailable or not t.BIG_CANE then
                        shouldMine = true
                    end
                elseif cat == "ZONE2_BIG" and t.ZONE2_BIG then
                    shouldMine = true
                elseif cat == "ZONE2_SMALL" and t.ZONE2_SMALL then
                    shouldMine = true
                end

                if shouldMine then
                    REMOTES.Game.Coins:FireServer(
                        "Mine", coin.Name, a.level * 2 - 1, a.id
                    )
                    lastFire[a.id] = now
                    break
                end
            end
        end

        task.wait()
    end
end)

