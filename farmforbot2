local last = {p1 = 0, p2 = 0, p3 = 0, p4 = 0}
local DELAY = 0.13

task.spawn(function()
    while _G.FARMING do
        local now = os.clock()

        for _, coin in ipairs(COINS:GetChildren()) do
            local nameObj = coin:FindFirstChild("CoinName")
            if not nameObj then continue end

            local name = nameObj.Value

            if BIG_CANES[name] then
                if now - last.p1 > DELAY then
                    REMOTES.Game.Coins:FireServer("Mine", coin.Name, LVL1 * 2 - 1, PET1)
                    last.p1 = now
                end

            elseif SMALL_CANES[name] then
                if now - last.p2 > DELAY then
                    REMOTES.Game.Coins:FireServer("Mine", coin.Name, LVL2 * 2 - 1, PET2)
                    last.p2 = now
                end

            elseif ZONE2_BIG[name] then
                if now - last.p3 > DELAY then
                    REMOTES.Game.Coins:FireServer("Mine", coin.Name, LVL3 * 2 - 1, PET3)
                    last.p3 = now
                end

            elseif ZONE2_SMALL[name] then
                if now - last.p4 > DELAY then
                    REMOTES.Game.Coins:FireServer("Mine", coin.Name, LVL4 * 2 - 1, PET4)
                    last.p4 = now
                end
            end
        end

        task.wait(0.05)
    end
end)

