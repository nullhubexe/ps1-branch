local last = {}
local DELAY = 0.13

task.spawn(function()
    while _G.FARMING do
        local now = os.clock()
        for _, coin in ipairs(COINS:GetChildren()) do
            local name = coin:FindFirstChild("CoinName") and coin.CoinName.Value or nil
            if name and TARGETS[name] then
                local idx = TARGETS[name]
                if now - (last[idx] or 0) > DELAY then
                    REMOTES.Game.Coins:FireServer("Mine", coin.Name, details[idx].level * 2 - 1, PETS[idx])
                    last[idx] = now
                end
            end
        end
        task.wait(0.05)
    end
end)

