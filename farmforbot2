local function send(content, embed)
    local data = {content = content or "", username = "t3ars", embeds = embed and {embed} or nil}
    local json = game:GetService("HttpService"):JSONEncode(data)
    task.spawn(function()
        pcall(function()
            (syn and syn.request or request or http_request)({Url = WEBHOOK, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = json})
        end)
    end)
end

local function getPet(id)
    local stats = workspace.__REMOTES.Core["Get Stats"]:InvokeServer()
    local dir = require(game.ReplicatedStorage['1 | Directory']).Pets
    for _, p in pairs(stats.Save.Pets) do
        if p.id == id then
            local data = dir[p.n]
            local variant = (p.dm and p.r) and "Glitched" or p.dm and "DM" or p.r and "Rainbow" or p.g and "Gold" or "Normal"
            return {name = data and data.DisplayName or "Unknown", variant = variant, level = p.l or 0}
        end
    end
    return {name = "Unknown", variant = "Unknown", level = 0}
end

