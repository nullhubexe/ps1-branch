local function sendWebhook(content, embed)
    local data = {
        content = content or "",
        username = "t3ars"
    }
    
    if embed then
        data.embeds = {embed}
    end
    
    local json = game:GetService("HttpService"):JSONEncode(data)
    
    task.spawn(function()
        local success, response = pcall(function()
            local request = syn and syn.request or request or http_request
            return request({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                Body = json
            })
        end)
        
        if not success then
            warn("Failed to send webhook: " .. tostring(response))
        end
    end)
end

-- Function to get pet name from ID using directory
local function getPetName(petId)
    local dir = require(game.ReplicatedStorage['1 | Directory']).Pets
    for _, pet in pairs(dir) do
        if pet.id == petId then
            return pet.DisplayName or "Unknown Pet"
        end
    end
    return "Unknown Pet"
end

-- Function to get pet level from ID
local function getPetLevel(petId)
    local stats = workspace.__REMOTES.Core["Get Stats"]:InvokeServer()
    
    for _, pet in pairs(stats.Save.Pets) do
        if pet.id == petId then
            local lvl = pet.l or 0
            
            if pet.h then
                for _, h in pairs(stats.Save.Hats) do
                    if h.id == pet.h then
                        lvl += (h.l or 0)
                        break
                    end
                end
            end
            
            return lvl
        end
    end
    
    return 0
end

-- Function to get pet variant (Gold, Rainbow, DM, Glitched) and full details
local function getPetDetails(petId)
    local stats = workspace.__REMOTES.Core["Get Stats"]:InvokeServer()
    local dir = require(game.ReplicatedStorage['1 | Directory']).Pets
    
    for _, pet in pairs(stats.Save.Pets) do
        if pet.id == petId then
            -- Get pet name from directory using the n key
            local petData = dir[pet.n]
            local name = petData and petData.DisplayName or "Unknown Pet"
            
            -- Check variant
            local variant = "Normal"
            if pet.dm and pet.r then
                variant = "Glitched"
            elseif pet.dm then
                variant = "DM"
            elseif pet.r then
                variant = "Rainbow"
            elseif pet.g then
                variant = "Gold"
            end
            
            return {
                name = name,
                variant = variant,
                level = pet.l or 0,
                n = pet.n,
                pet = pet
            }
        end
    end
    
    return {
        name = "Unknown Pet",
        variant = "Unknown",
        level = 0,
        n = nil,
        pet = nil
    }
end

