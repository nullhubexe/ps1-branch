local function renderWL(filter)
    for _, c in ipairs(WLList:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    filter = (filter or ""):lower()
    local sorted = {}
    for _, n in ipairs(Settings.Whitelist) do table.insert(sorted, n) end
    table.sort(sorted)

    local y = 0
    for _, name in ipairs(sorted) do
        if filter == "" or name:lower():find(filter, 1, true) then
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, -8, 0, 30)
            row.Position = UDim2.new(0, 4, 0, y)
            row.BackgroundColor3 = PANEL2
            row.BorderSizePixel = 0
            row.Parent = WLList
            Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, -50, 1, 0)
            lbl.Position = UDim2.new(0, 12, 0, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = name
            lbl.TextColor3 = TEXT
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 13
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent = row

            local rm = Instance.new("TextButton")
            rm.Size = UDim2.new(0, 24, 0, 24)
            rm.Position = UDim2.new(1, -30, 0.5, -12)
            rm.BackgroundColor3 = Color3.fromRGB(210, 70, 70)
            rm.Text = "×"
            rm.TextColor3 = Color3.fromRGB(255, 255, 255)
            rm.Font = Enum.Font.GothamBold
            rm.TextSize = 15
            rm.Parent = row
            Instance.new("UICorner", rm).CornerRadius = UDim.new(0, 5)
            rm.MouseButton1Click:Connect(function()
                for i, v in ipairs(Settings.Whitelist) do
                    if v == name then table.remove(Settings.Whitelist, i); break end
                end
                renderWL(WLSearch.Text)
                if renderPets then renderPets(PetSearch.Text) end
            end)

            y = y + 34
        end
    end
    WLList.CanvasSize = UDim2.new(0, 0, 0, y + 8)
end

WLSearch:GetPropertyChangedSignal("Text"):Connect(function() renderWL(WLSearch.Text) end)

