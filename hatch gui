------------------------------------------------------------
-- HELPERS
------------------------------------------------------------
local function isBlacklisted(id)
    return table.find(Settings.Whitelist, Lib[tonumber(id)]) == nil
end

local function GetStats()
    local ok, res = pcall(function()
        return REMOTES.Core["Get Other Stats"]:InvokeServer()[LP.Name]
    end)
    return ok and res or nil
end

local function combine()
    local Stats = GetStats()
    if not Stats or not Stats.Save then return end
    local GT, RT, DMT = {}, {}, {}
    for _, Pet in pairs(Stats.Save.Pets) do
        local T = Pet.n
        if not isBlacklisted(T) then
            if not (Pet.g or Pet.r or Pet.dm) then
                GT[T] = (GT[T] or 0) + 1
            elseif Pet.g and not (Pet.r or Pet.dm) then
                RT[T] = (RT[T] or 0) + 1
            elseif Pet.r and not (Pet.g or Pet.dm) then
                DMT[T] = (DMT[T] or 0) + 1
            end
        end
    end
    for PetN, Amount in pairs(GT) do
        if Amount >= 10 then
            for _, Pet in pairs(Stats.Save.Pets) do
                if tostring(Pet.n) == tostring(PetN) and not (Pet.g or Pet.r or Pet.dm) and Amount >= 10 then
                    pcall(function() REMOTES.Game["Golden Pets"]:InvokeServer(Pet.id) end)
                    Amount = 0
                end
            end
        end
    end
    for PetN, Amount in pairs(RT) do
        if Amount >= 7 then
            for _, Pet in pairs(Stats.Save.Pets) do
                if tostring(Pet.n) == tostring(PetN) and Pet.g and not (Pet.r or Pet.dm) and Amount >= 7 then
                    pcall(function() REMOTES.Game["Rainbow Pets"]:InvokeServer(Pet.id) end)
                    Amount = 0
                end
            end
        end
    end
    for PetN, Amount in pairs(DMT) do
        if Amount >= 5 then
            for _, Pet in pairs(Stats.Save.Pets) do
                if tostring(Pet.n) == tostring(PetN) and Pet.r and not (Pet.g or Pet.dm) and Amount >= 5 then
                    pcall(function() REMOTES.Game["Dark Matter Pets"]:InvokeServer(Pet.id) end)
                    Amount = 0
                end
            end
        end
    end
end

