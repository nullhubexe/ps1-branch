------------------------------------------------------------
-- HATCH LOOP
------------------------------------------------------------
local Hatching = false

local function startHatching()
    if Hatching then return end
    Hatching = true
    spawn(function()
        while Hatching do
            local Stats = GetStats()
            if not Stats or not Stats.Save then
                wait(1)
                continue
            end

            local Save = Stats.Save
            local numToBuy = (Save.PetSlots - #Save.Pets)
            if numToBuy <= 0 then wait(0.5); continue end

            local toDelete = {}
            local done = 0

            for i = 1, numToBuy do
                spawn(function()
                    pcall(function()
                        local success, pet = REMOTES.Game.Shop:InvokeServer("Buy", "Eggs", Settings.Tier)
                        if success and pet and pet[1] and pet[1][1] and isBlacklisted(pet[1][1].n) then
                            table.insert(toDelete, pet[1][1].id)
                        end
                    end)
                    done = done + 1
                end)
            end

            local t = 0
            while done < numToBuy and t < 15 do
                wait(0.1); t = t + 0.1
            end

            if #toDelete > 0 then
                pcall(function()
                    REMOTES.Game.Inventory:InvokeServer("MultiDelete", toDelete)
                end)
            end
            if Settings.Combine then spawn(combine) end

            wait(0.3)
        end
    end)
end

local function stopHatching()
    Hatching = false
end

