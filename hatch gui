local function createTab(name, order, total)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1/total, -6, 1, -6)
    btn.Position = UDim2.new((order-1)/total, 3, 0, 3)
    btn.BackgroundColor3 = PANEL2
    btn.Text = name
    btn.TextColor3 = SUB
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.AutoButtonColor = false
    btn.Parent = TabBar
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local page = Instance.new("Frame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.Parent = PageHolder

    table.insert(Tabs, {btn = btn, page = page, name = name})
    return page
end

local function switchTab(idx)
    for i, t in ipairs(Tabs) do
        local on = (i == idx)
        t.page.Visible = on
        t.btn.BackgroundColor3 = on and ACCENT or PANEL2
        t.btn.TextColor3 = on and Color3.fromRGB(255,255,255) or SUB
    end
    activeTab = idx
end

