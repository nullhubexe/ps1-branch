--[[
============================================================================
  Pet Simulator!  --  Cane Farm (optimized / lag-resistant)
============================================================================
  * Every pet mines the BIG canes.
  * Pet 58726936 also mines the SMALL canes.
  * Only tracks the canes it actually needs instead of scanning every coin
    in the map every tick, so it stays light over long sessions instead of
    degrading after a few hours.
  * Re-run safe: executing this again stops the previous run first, so you
    never end up with 5 stacked copies spamming the server.
============================================================================
]]

--=============================== CONFIG =================================--
local AUTO_REJOIN     = true    -- reload the client every REJOIN_INTERVAL
local REJOIN_INTERVAL = 300     -- seconds between rejoins

local DELAY           = 0.13    -- seconds between mines, per pet / per target
local STEP            = 0.05    -- farm loop tick
local LEVEL_INTERVAL  = 60      -- seconds between pet level refreshes
local RECONCILE       = 15      -- seconds between safety re-scans of the coins

local WEBHOOK_URL     = ""      -- optional Discord webhook URL ("" = disabled)

-- What every pet mines
local BIG_CANE        = "Christmas3 Cane"        -- 18,000,000,000 HP
local SMALL_CANE      = "Christmas3 Small Cane"  --    900,000,000 HP

local ASSIGNMENTS = {
    { id = 58726936, targets = { BIG_CANE, SMALL_CANE } }, -- also does small canes
    { id = 96872431, targets = { BIG_CANE } },
    { id = 84288999, targets = { BIG_CANE } },
    { id = 64463355, targets = { BIG_CANE } },
}
--========================================================================--

local Players         = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local HttpService     = game:GetService("HttpService")
local LocalPlayer     = Players.LocalPlayer

-- ============================ single instance ========================== --
-- _G survives between executions in the same session, so a second run can
-- tear the first one down instead of leaving its loops and connections alive.
local running = true
local conns   = {}

local function cleanup()
    running = false
    for _, c in ipairs(conns) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(conns)
end

if _G.__PSX_FARM_CLEANUP then
    pcall(_G.__PSX_FARM_CLEANUP)
end
_G.__PSX_FARM_CLEANUP = cleanup
_G.FARMING = true

-- ================================ webhook ============================== --
-- The original script called sendWebhook() but never defined it. Reuse
-- whatever global sender the environment already has; otherwise build
-- one that posts to WEBHOOK_URL. With an empty URL it never does anything.
local sendWebhook = _G.sendWebhook
if type(sendWebhook) ~= "function" then
    sendWebhook = function(content, embed)
        if WEBHOOK_URL == "" then return end
        local request = (_G.syn and _G.syn.request)
            or (_G.http and _G.http.request)
            or _G.http_request
            or _G.request
        if not request then return end
        local body = { content = content }
        if embed then body.embeds = { embed } end
        pcall(request, {
            Url     = WEBHOOK_URL,
            Method  = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body    = HttpService:JSONEncode(body),
        })
    end
    _G.sendWebhook = sendWebhook
end

local function notify(content, embed)
    task.spawn(function()
        pcall(sendWebhook, content, embed)
    end)
end

-- ========================= load helper scripts ========================= --
-- Loaded once per session. Re-loading the FPS script would stack another
-- DescendantAdded hook every time, which is a big source of long-run lag.
if not _G.__PSX_ANTIFPS then
    _G.__PSX_ANTIFPS = true
    pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/nullhubexe/ps1-branch/refs/heads/main/antifps"))()
    end)
end

if not _G.__PSX_TIMER_GUI then
    _G.__PSX_TIMER_GUI = true
    pcall(function()
        loadstring(game:HttpGet("https://pastebin.com/raw/S7uzDeEE"))()
    end)
end

pcall(function()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    local events = gui and gui:FindFirstChild("Events")
    if events then events:ClearAllChildren() end
end)

-- ============================ game references ========================== --
local REMOTES = workspace:WaitForChild("__REMOTES", 30)
local THINGS  = workspace:WaitForChild("__THINGS", 30)
if not (REMOTES and THINGS) then
    warn("[cane farm] __REMOTES / __THINGS not found, aborting")
    return
end
local COINS = THINGS:WaitForChild("Coins", 30)
if not COINS then
    warn("[cane farm] Coins container not found, aborting")
    return
end

-- ============================== pet levels ============================= --
-- One Get Stats call gives every pet's level, instead of one call per pet.
local function fetchLevels()
    local levels = {}
    local ok, stats = pcall(function()
        return REMOTES.Core["Get Stats"]:InvokeServer()
    end)
    if ok and type(stats) == "table" and stats.Save and stats.Save.Pets then
        for _, p in pairs(stats.Save.Pets) do
            if type(p) == "table" and p.id then
                levels[p.id] = tonumber(p.l) or 0
            end
        end
    end
    return levels
end

-- One "worker" per pet/target pair.
local workers = {}
for _, a in ipairs(ASSIGNMENTS) do
    for _, target in ipairs(a.targets) do
        table.insert(workers, { id = a.id, target = target, last = 0, lvl = 1 })
    end
end

local initialLevels = fetchLevels()
for _, w in ipairs(workers) do
    local lvl = initialLevels[w.id]
    if lvl and lvl > 0 then w.lvl = lvl end
end

-- ============================ coin tracking ============================ --
-- Only the canes are tracked, so the hot loop touches a handful of coins
-- rather than every coin on the map.
local tracked = { [BIG_CANE] = {}, [SMALL_CANE] = {} }

local function trackCoin(coin)
    if not coin:IsA("BasePart") then return end
    local nm = coin:FindFirstChild("CoinName") or coin:WaitForChild("CoinName", 8)
    if not nm then return end
    local bucket = tracked[nm.Value]
    if bucket then bucket[coin] = true end
end

for _, coin in ipairs(COINS:GetChildren()) do
    if coin:IsA("BasePart") then
        if coin:FindFirstChild("CoinName") then
            trackCoin(coin)
        else
            task.spawn(trackCoin, coin)
        end
    end
end

table.insert(conns, COINS.ChildAdded:Connect(function(coin)
    task.spawn(trackCoin, coin)
end))

table.insert(conns, COINS.ChildRemoved:Connect(function(coin)
    for _, bucket in pairs(tracked) do
        bucket[coin] = nil
    end
end))

local function pickTarget(name)
    local bucket = tracked[name]
    if not bucket then return nil end
    for coin in pairs(bucket) do
        if coin.Parent then
            local hp = coin:FindFirstChild("Health")
            if hp and hp.Value > 0 then
                return coin
            end
        else
            bucket[coin] = nil
        end
    end
    return nil
end

-- ============================== farm loop ============================== --
task.spawn(function()
    while running do
        local now = os.clock()

        for _, w in ipairs(workers) do
            if now - w.last >= DELAY then
                local coin = pickTarget(w.target)
                if coin then
                    w.last = now
                    local bonus = math.max(1, w.lvl * 2 - 1)
                    pcall(function()
                        REMOTES.Game.Coins:FireServer("Mine", coin.Name, bonus, w.id)
                    end)
                end
            end
        end

        task.wait(STEP)
    end
end)

-- ========================== level monitor ============================== --
task.spawn(function()
    while running do
        task.wait(LEVEL_INTERVAL)
        if not running then break end

        local levels = fetchLevels()
        local changed, seen = {}, {}
        for _, w in ipairs(workers) do
            local lvl = levels[w.id]
            if lvl and lvl > 0 and lvl ~= w.lvl then
                w.lvl = lvl
                if not seen[w.id] then
                    seen[w.id] = true
                    table.insert(changed, w)
                end
            end
        end

        if #changed > 0 then
            local fields = {}
            for _, w in ipairs(changed) do
                table.insert(fields, {
                    name = "Pet " .. w.id,
                    value = "Level: **" .. w.lvl .. "**",
                    inline = true,
                })
            end
            notify("**Pet Levels Updated**", {
                title = "Pet Levels Updated",
                color = 0x00aaff,
                fields = fields,
                timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
            })
        end
    end
end)

-- ========================= safety re-scan ============================== --
-- Cheap net for any coin whose CoinName was attached a frame late.
task.spawn(function()
    while running do
        task.wait(RECONCILE)
        if not running then break end
        for _, coin in ipairs(COINS:GetChildren()) do
            if coin:IsA("BasePart") then
                local nm = coin:FindFirstChild("CoinName")
                if nm then
                    local bucket = tracked[nm.Value]
                    if bucket then bucket[coin] = true end
                end
            end
        end
    end
end)

-- ============================ debris cleaner ========================== --
task.spawn(function()
    local debris = workspace:WaitForChild("__DEBRIS", 30)
    if not debris then return end

    local function wipe(child)
        if child:IsA("BasePart") then
            task.defer(function()
                if child and child.Parent then
                    pcall(function() child:Destroy() end)
                end
            end)
        end
    end

    for _, child in ipairs(debris:GetChildren()) do
        wipe(child)
    end
    table.insert(conns, debris.ChildAdded:Connect(wipe))
end)

-- ============================= auto rejoin ============================= --
-- Reloading the client periodically clears the memory the client builds up.
-- Only useful if your executor re-runs this on join.
if AUTO_REJOIN then
    task.spawn(function()
        while running do
            task.wait(REJOIN_INTERVAL)
            if not running then break end
            if not (LocalPlayer and LocalPlayer.Parent) then break end
            pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
            end)
        end
    end)
end

-- ================================ start ================================ --
notify("**Farm Started**", {
    title = "Farm Started",
    description = "Cane farm running",
    color = 0x00ff00,
    fields = {
        { name = "Player", value = LocalPlayer.DisplayName or LocalPlayer.Name, inline = true },
        { name = "Server", value = game.JobId, inline = true },
        { name = "Big canes", value = "All pets", inline = true },
        { name = "Small canes", value = "58726936", inline = true },
    },
    timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
})

print("[cane farm] started -- big canes: all pets | small canes: 58726936")
