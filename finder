    --// UTIL FUNCTIONS
    local function formatNumber(n)
        return tostring(n):reverse():gsub("%d%d%d","%1,"):reverse():gsub("^,","")
    end

    local function isPetBlacklisted(name)
        return BLACKLISTED_PETS[name:lower()] == true
