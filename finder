        if scanTimer >= SCAN_INTERVAL then
            scanTimer = 0
            task.spawn(performScan)
        end

        -- Hop at interval
        if hopTimer >= 30 then -- Hop every 30 seconds
            hopTimer = 0
            task.spawn(serverHop)
        end
    end)

    --// Fallback timer-based loop in case Heartbeat fails
    task.spawn(function()
        while true do
            task.wait(SCAN_INTERVAL)
            performScan()
        end
    end)

