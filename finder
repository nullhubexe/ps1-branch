    --// Optimized Server Hopper
    local visited = {}
    local FILE_NAME = "visited_servers.json"
    local lastHopTime = 0
    local HOP_COOLDOWN = 15 -- seconds between hops

    pcall(function()
        visited = HttpService:JSONDecode(readfile(FILE_NAME))
    end)

    local function saveVisited()
        pcall(function()
            writefile(FILE_NAME, HttpService:JSONEncode(visited))
        end)
    end

    local function getServers()
        local servers = {}
        local cursor = ""

        repeat
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"
            if cursor ~= "" then url = url .. "&cursor=" .. cursor end

            local success, data = pcall(function()
                return HttpService:JSONDecode(game:HttpGet(url))
            end)

            if success and data then
                for _, server in ipairs(data.data or {}) do
                    if server.playing < server.maxPlayers then
                        table.insert(servers, server)
                    end
                end
                cursor = data.nextPageCursor or ""
            else
                cursor = ""
            end

            task.wait(0.1)

        until cursor == ""

        return servers
    end

    local function serverHop()
        local currentTime = tick()
        if currentTime - lastHopTime < HOP_COOLDOWN then return end

        local servers = getServers()
        if #servers == 0 then return end

        local choices = {}
        for _, server in ipairs(servers) do
            if not visited[server.id] then
                table.insert(choices, server)
            end
        end

        if #choices == 0 then
            visited = {}
            saveVisited()
            choices = servers
        end

        if #choices == 0 then return end

        table.sort(choices, function(a, b)
            return a.playing > b.playing
        end)

        local target = choices[1]
        visited[target.id] = true
        saveVisited()
        lastHopTime = currentTime

        pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, target.id, LocalPlayer)
        end)
    end

    --// Main scanning with error recovery
    local function performScan()
        pcall(function()
            -- Cache directory and remote to avoid repeated lookups
            if not directoryCache then
                local dirModule = game.ReplicatedStorage:FindFirstChild("1 | Directory")
                if not dirModule then return end
                directoryCache = require(dirModule).Pets
            end

            if not remoteCache then
                local core = workspace.__REMOTES and workspace.__REMOTES.Core
                if not core then return end
                remoteCache = core:FindFirstChild("Get Other Stats")
                if not remoteCache then return end
            end

            local success, stats = pcall(function() 
                return remoteCache:InvokeServer() 
            end)
            
            if not success or not stats then return end

            for playerName, data in pairs(stats) do
                if not PLAYER_BLACKLIST[playerName] then
                    local pets = data and data.Save and data.Save.Pets
                    if not pets then continue end

                    local plr = Players:FindFirstChild(playerName)
                    local userId = plr and plr.UserId or 0

                    for _, pet in pairs(pets) do
                        if type(pet) == "table" and pet.n and pet.l then
                            local petData = directoryCache[pet.n]
                            if not petData then continue end

                            local petName = petData.DisplayName or pet.n

                            if not isPetBlacklisted(petName) then
                                local baseMax = petData.Level and petData.Level[2] or 0
                                local multi = (pet.g and 3) or (pet.r and 6) or (pet.dm and 18) or 1
                                local maxLevel = baseMax * multi

                                local petType = "Regular"
                                if pet.r and pet.dm then 
                                    petType = "Glitched"  
                                elseif pet.dm then 
                                    petType = "DM"  
                                elseif pet.r then 
                                    petType = "Rainbow"  
                                elseif pet.g then 
                                    petType = "Gold"  
                                end  

                                if petType ~= "Regular" then
                                    if petType == "Glitched" then
                                        local excluded = false
                                        for _, ex in pairs(excludedGlitchPets) do
                                            if petName:lower() == ex:lower() then
                                                excluded = true
                                                break
                                            end
                                        end
                                        if not excluded then
                                            sendWebhook(playerName, userId, pet.l, "Glitched", petName, maxLevel)
                                        end
                                    else
                                        if pet.l >= (maxLevel * OVERCAP_THRESHOLD) and pet.l >= MIN_OVERCAP then
                                            sendWebhook(playerName, userId, pet.l, petType, petName, maxLevel)
                                        elseif not ONLY_30_PERCENT and pet.l >= maxLevel then
                                            sendWebhook(playerName, userId, pet.l, petType, petName, maxLevel)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end)
    end

    --// Main loop with error recovery
    local scanTimer = 0
